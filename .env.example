# Port the server listens on (API + built UI in production)
PORT=4310
# Interface to bind. Keep 127.0.0.1 so the app is only reachable from this machine.
HOST=127.0.0.1
# Where the SQLite database and automatic backups live
DATA_DIR=./data
# Optional: require a password to open the app (recommended if HOST is not 127.0.0.1)
APP_PASSWORD=
